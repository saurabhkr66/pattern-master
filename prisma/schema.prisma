generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  attempts     Attempt[]
  userNotes    UserNote[]
}

model Pattern {
  id           String              @id @default(uuid())
  exam_type    String
  subject      String
  topic_name   String
  atomic_logic String
  branch       String
  short_notes  String?
  short_notes_hindi String?
  questions    GeneratedQuestion[]
  pyqs         PYQ[]
  userNotes    UserNote[]

  @@unique([exam_type, branch, topic_name], name: "pattern_identifier")
  @@index([exam_type, branch, subject], name: "pattern_subject_lookup")
}

model SubjectPattern {
  id           String       @id @default(uuid())
  subject_name String
  branch       String       @default("CSE")
  pyqs         SubjectPYQ[]

  @@unique([subject_name, branch], name: "subject_pattern_identifier")
}

model SubjectPYQ {
  id                 String         @id @default(uuid())
  subject_pattern_id String
  question_text      String
  question_text_hindi String?
  options            Json
  options_hindi      Json?
  correct_answer     String
  explanation        String
  explanation_hindi  String?
  year               Int
  question_type      String         @default("MCQ")
  marks              Int            @default(1)
  branch             String         @default("CSE")
  images             Json?
  created_at         DateTime       @default(now())
  attempts           Attempt[]
  subject_pattern    SubjectPattern @relation(fields: [subject_pattern_id], references: [id])

  @@unique([subject_pattern_id, question_text], name: "subject_pyq_identifier")
}

model PYQ {
  id             String    @id @default(uuid())
  pattern_id     String
  question_text  String
  question_text_hindi String?
  options        Json
  options_hindi  Json?
  correct_answer String
  explanation    String
  explanation_hindi String?
  year          Int
  exam_type      String
  created_at     DateTime  @default(now())
  question_type  String    @default("MCQ")
  marks          Int       @default(1)
  images         Json?
  attempts       Attempt[]
  pattern        Pattern   @relation(fields: [pattern_id], references: [id])

  @@unique([pattern_id, question_text], name: "pyq_identifier")
  @@index([pattern_id, year(sort: Desc)])
}

model GeneratedQuestion {
  id               String    @id @default(uuid())
  pattern_id       String
  question_text    String
  question_text_hindi String?
  options          Json
  options_hindi    Json?
  correct_answer   String
  explanation      String
  explanation_hindi String?
  difficulty_level String
  semantic_hash    String    @unique
  created_at       DateTime  @default(now())
  question_type    String    @default("MCQ")
  marks            Int       @default(1)
  images           Json?
  attempts         Attempt[]
  pattern          Pattern   @relation(fields: [pattern_id], references: [id])

  @@index([pattern_id, created_at(sort: Desc)])
}

model Attempt {
  id             String             @id @default(uuid())
  user_id        String
  question_id    String?
  is_correct     Boolean
  created_at     DateTime           @default(now())
  pyq_id         String?
  user_answer    String?
  subject_pyq_id String?
  pyq            PYQ?               @relation(fields: [pyq_id], references: [id])
  question       GeneratedQuestion? @relation(fields: [question_id], references: [id])
  subject_pyq    SubjectPYQ?        @relation(fields: [subject_pyq_id], references: [id])
  user           User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_correct, created_at(sort: Desc)])
  @@index([question_id, user_id, is_correct])
  @@index([pyq_id, user_id, is_correct])
  @@index([subject_pyq_id, user_id, is_correct])
}

model TestSession {
  id              String            @id @default(uuid())
  user_id         String
  score           Float
  max_score       Float
  total_questions Int
  correct_count   Int
  wrong_count     Int
  skipped_count   Int
  time_taken_secs Int?
  answers         Json
  created_at      DateTime          @default(now())
  mock_test_id    String?
  mock_test       MockTestTemplate? @relation(fields: [mock_test_id], references: [id])

  @@index([user_id, created_at(sort: Desc)])
}

model MockTestTemplate {
  id              String        @id @default(uuid())
  title           String
  subjects        String[]
  total_questions Int
  max_score       Int
  questions       Json
  created_at      DateTime      @default(now())
  sessions        TestSession[]
}
model UserNote {
  id         String   @id @default(uuid())
  user_id    String
  pattern_id String
  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pattern    Pattern  @relation(fields: [pattern_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, pattern_id])
}
