generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  exam_type    String?
  branch       String?
  exam_date    DateTime?
  target_score Int?
  onboarded    Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  attempts     Attempt[]
}

model Pattern {
  id           String              @id @default(uuid())
  exam_type    String
  subject      String
  topic_name   String
  atomic_logic String
  branch       String
  questions    GeneratedQuestion[]
  pyqs         PYQ[]
  short_notes  String?

  @@unique([exam_type, branch, topic_name], name: "pattern_identifier")
}

model SubjectPattern {
  id           String       @id @default(uuid())
  subject_name String       @unique
  pyqs         SubjectPYQ[]
}

model SubjectPYQ {
  id                 String         @id @default(uuid())
  subject_pattern_id String
  question_text      String
  options            Json
  correct_answer     String
  explanation        String
  year               Int
  question_type      String         @default("MCQ")
  images             Json?
  created_at         DateTime       @default(now())
  subject_pattern    SubjectPattern @relation(fields: [subject_pattern_id], references: [id])
  attempts           Attempt[]

  @@unique([subject_pattern_id, question_text], name: "subject_pyq_identifier")
}

model PYQ {
  id             String   @id @default(uuid())
  pattern_id     String
  question_text  String
  options        Json
  correct_answer String
  explanation    String
  year           Int
  exam_type      String
  question_type  String   @default("MCQ")
  images         Json?
  created_at     DateTime @default(now())
  attempts       Attempt[]
  pattern        Pattern  @relation(fields: [pattern_id], references: [id])

  @@unique([pattern_id, question_text], name: "pyq_identifier")
}

model GeneratedQuestion {
  id               String    @id @default(uuid())
  pattern_id       String
  question_text    String
  options          Json
  correct_answer   String
  explanation      String
  difficulty_level String
  question_type    String    @default("MCQ")
  images           Json?
  semantic_hash    String    @unique
  created_at       DateTime  @default(now())
  attempts         Attempt[]
  pattern          Pattern   @relation(fields: [pattern_id], references: [id])
}

model Attempt {
  id          String             @id @default(uuid())
  user_id     String
  question_id String?
  pyq_id      String?
  user_answer String?
  is_correct  Boolean
  created_at  DateTime           @default(now())
  user        User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question    GeneratedQuestion? @relation(fields: [question_id], references: [id])
  pyq                PYQ?               @relation(fields: [pyq_id], references: [id])
  subject_pyq        SubjectPYQ?        @relation(fields: [subject_pyq_id], references: [id])
  subject_pyq_id     String?

  @@index([user_id, is_correct, created_at(sort: Desc)])
}
