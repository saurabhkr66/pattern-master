generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  preferred_exam   String?
  preferred_branch String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  attempts         Attempt[]
  userNotes        UserNote[]
  flashcards       Flashcard[]
  bookmarks        Bookmark[]
  questionReports  QuestionReport[]
}

model Pattern {
  id                String              @id @default(uuid())
  exam_type         String
  subject           String
  topic_name        String
  atomic_logic      String
  branch            String
  short_notes       String?
  short_notes_hindi String?
  questions         GeneratedQuestion[]
  pyqs              PYQ[]
  userNotes         UserNote[]

  @@unique([exam_type, branch, topic_name], name: "pattern_identifier")
  @@index([exam_type, branch, subject], name: "pattern_subject_lookup")
}

model PYQ {
  id                  String           @id @default(uuid())
  pattern_id          String
  question_text       String
  question_text_hindi String?
  options             Json
  options_hindi       Json?
  correct_answer      String
  explanation         String
  explanation_hindi   String?
  year                Int
  exam_type           String
  created_at          DateTime         @default(now())
  question_type       String           @default("MCQ")
  marks               Int              @default(1)
  images              Json?
  question_hash       String?
  content_hash        String?
  attempts            Attempt[]
  pattern             Pattern          @relation(fields: [pattern_id], references: [id])
  bookmarks           Bookmark[]
  questionReports     QuestionReport[]

  topic               String?          // AI assigned topic
  @@unique([pattern_id, question_text], name: "pyq_identifier")
  @@unique([pattern_id, question_hash], name: "pyq_hash_identifier")
  @@index([pattern_id, year(sort: Desc)])
  @@index([pattern_id])
}

model GeneratedQuestion {
  id                  String           @id @default(uuid())
  pattern_id          String
  question_text       String
  question_text_hindi String?
  options             Json
  options_hindi       Json?
  correct_answer      String
  explanation         String
  explanation_hindi   String?
  difficulty_level    String
  semantic_hash       String           @unique
  created_at          DateTime         @default(now())
  question_type       String           @default("MCQ")
  marks               Int              @default(1)
  images              Json?
  attempts            Attempt[]
  pattern             Pattern          @relation(fields: [pattern_id], references: [id])
  bookmarks           Bookmark[]
  questionReports     QuestionReport[]

  topic               String?          // AI assigned topic
  @@index([pattern_id, created_at(sort: Desc)])
  @@index([pattern_id])
}

model Attempt {
  id               String             @id @default(uuid())
  user_id          String
  question_id      String?
  is_correct       Boolean
  created_at       DateTime           @default(now())
  pyq_id           String?
  user_answer      String?
  mock_question_id String?
  time_spent       Int?
  mock_test_id     String?
  MockTestTemplate MockTestTemplate?  @relation(fields: [mock_test_id], references: [id])
  pyq              PYQ?               @relation(fields: [pyq_id], references: [id])
  question         GeneratedQuestion? @relation(fields: [question_id], references: [id])
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_correct, created_at(sort: Desc)])
  @@index([question_id, user_id, is_correct])
  @@index([pyq_id, user_id, is_correct])
}

model TestSession {
  id              String            @id @default(uuid())
  user_id         String
  exam_type       String            @default("GATE")
  branch          String?
  score           Float
  max_score       Float
  total_questions Int
  correct_count   Int
  wrong_count     Int
  skipped_count   Int
  time_taken_secs Int?
  section_scores  Json?
  answers         Json
  created_at      DateTime          @default(now())
  mock_test_id    String?
  mock_test       MockTestTemplate? @relation(fields: [mock_test_id], references: [id])

  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id, exam_type, created_at(sort: Desc)])
}

model MockTestTemplate {
  id              String        @id @default(uuid())
  exam_type       String        @default("GATE")
  branch          String?
  mock_number     Int           @default(0)
  mode            String        @default("random")
  title           String
  subjects        String[]
  total_questions Int
  max_score       Int
  duration_secs   Int           @default(10800)
  sections        Json?
  topics          String[]      @default([]) // Summary of all topics in this test
  questions       Json
  content_hash    String?
  created_at      DateTime      @default(now())
  Attempt         Attempt[]
  sessions        TestSession[]

  @@index([exam_type, branch, mock_number, mode])
}

model UserNote {
  id         String   @id @default(uuid())
  user_id    String
  pattern_id String
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pattern Pattern @relation(fields: [pattern_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, pattern_id])
}

/// Spaced Repetition System card state per user per question.
/// Uses a SuperMemo-2 inspired algorithm.
model Flashcard {
  id             String  @id @default(uuid())
  user_id        String
  // Exactly one of these is set
  question_id    String?
  pyq_id         String?
  mock_question_id String?

  // SM-2 fields
  interval    Int      @default(0) // Days until next review
  ease_factor Float    @default(2.5) // Difficulty multiplier
  repetitions Int      @default(0) // Consecutive successful reviews
  next_review DateTime @default(now())
  status      String   @default("new") // new | learning | review | lapsed

  last_grade String? // again | hard | good | easy
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id])
  @@unique([user_id, pyq_id])
  @@unique([user_id, mock_question_id])
  @@index([user_id, next_review])
  @@index([user_id, status])
}

model Bookmark {
  id             String  @id @default(uuid())
  user_id        String
  // Exactly one of these is set
  question_id    String?
  pyq_id         String?
  mock_question_id String?

  created_at DateTime @default(now())

  user        User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question    GeneratedQuestion? @relation(fields: [question_id], references: [id], onDelete: Cascade)
  pyq         PYQ?               @relation(fields: [pyq_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id])
  @@unique([user_id, pyq_id])
  @@unique([user_id, mock_question_id])
  @@index([user_id])
}

model TestSessionDraft {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id      String
  mock_test_id String?
  exam_type    String
  branch       String?
  started_at   DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @db.Timestamptz(6)
  state        Json     @default("{}")

  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@index([user_id, mock_test_id])
  @@index([expires_at])
}

model QuestionReport {
  id      String @id @default(uuid())
  user_id String

  // Exactly one of these is set
  question_id    String?
  pyq_id         String?
  mock_question_id String?

  reason  String // e.g., "wrong_answer", "typo", "bad_explanation", "other"
  details String?
  status  String  @default("pending") // pending | resolved | rejected

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user        User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question    GeneratedQuestion? @relation(fields: [question_id], references: [id], onDelete: Cascade)
  pyq         PYQ?               @relation(fields: [pyq_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@index([question_id])
  @@index([pyq_id])
}
