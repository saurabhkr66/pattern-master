generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  preferred_branch String?
  preferred_exam   String?
  attempts         Attempt[]
  bookmarks        Bookmark[]
  flashcards       Flashcard[]
  questionReports  QuestionReport[]
  userNotes        UserNote[]
}

model Pattern {
  id                String              @id @default(uuid())
  exam_type         String
  subject           String
  topic_name        String
  atomic_logic      String
  branch            String
  short_notes       String?
  short_notes_hindi String?
  exam_slug         String?             @default(dbgenerated("btrim(lower(regexp_replace(exam_type, '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text)), '-'::text)"))
  branch_slug       String?             @default(dbgenerated("btrim(lower(regexp_replace(branch, '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text)), '-'::text)"))
  subject_slug      String?             @default(dbgenerated("btrim(lower(regexp_replace(subject, '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text)), '-'::text)"))
  topic_slug        String?             @default(dbgenerated("btrim(lower(regexp_replace(topic_name, '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text)), '-'::text)"))
  questions         GeneratedQuestion[]
  pyqs              PYQ[]
  userNotes         UserNote[]

  @@unique([exam_type, branch, topic_name], name: "pattern_identifier")
  @@index([exam_type, branch, subject], map: "pattern_subject_lookup")
  @@index([exam_slug, branch_slug, subject_slug, topic_slug], map: "pattern_slug_lookup")
  @@index([topic_name(ops: raw("gin_trgm_ops"))], map: "pattern_topic_trgm", type: Gin)
}

model PYQ {
  id                     String           @id @default(uuid())
  pattern_id             String
  question_text          String
  options                Json
  correct_answer         String
  explanation            String
  year                   Int
  exam_type              String
  created_at             DateTime         @default(now())
  question_type          String           @default("MCQ")
  images                 Json?
  marks                  Int              @default(1)
  explanation_hindi      String?
  options_hindi          Json?
  question_text_hindi    String?
  topic                  String?
  content_hash           String?
  question_hash          String?
  // Option B: pre-rendered KaTeX/markdown HTML (see lib/math/renderHtml).
  // Null = not yet backfilled → MathHtml falls back to live rendering.
  question_html          String?
  explanation_html       String?
  options_html           Json?
  question_html_hindi    String?
  explanation_html_hindi String?
  options_html_hindi     Json?
  render_version         Int              @default(0)
  // AI answer-review pass (admin/ai-review). Null reviewed_at = not yet reviewed,
  // so the review queue surfaces it. ai_answer_mismatch mirrors the QuestionReport
  // flag for fast filtering/display without joining.
  ai_reviewed_at         DateTime?
  ai_answer_mismatch     Boolean?
  ai_detected_answer     String?
  ai_review_model        String?
  attempts               Attempt[]
  bookmarks              Bookmark[]
  pattern                Pattern          @relation(fields: [pattern_id], references: [id])
  questionReports        QuestionReport[]

  @@unique([pattern_id, question_text], name: "pyq_identifier")
  @@unique([pattern_id, question_hash], name: "pyq_hash_identifier")
  @@index([pattern_id, year(sort: Desc)])
  @@index([pattern_id])
  @@index([ai_reviewed_at])
  // Serves the unfiltered sitemap groupBy by ["exam_type","year"]
  // (lib/sitemap-data.ts) as an index-only scan instead of a full-table
  // seq scan + hash aggregate.
  @@index([exam_type, year])
}

model GeneratedQuestion {
  id                     String           @id @default(uuid())
  pattern_id             String
  question_text          String
  options                Json
  correct_answer         String
  explanation            String
  difficulty_level       String
  semantic_hash          String           @unique
  created_at             DateTime         @default(now())
  question_type          String           @default("MCQ")
  images                 Json?
  marks                  Int              @default(1)
  explanation_hindi      String?
  options_hindi          Json?
  question_text_hindi    String?
  topic                  String?
  // Option B: pre-rendered KaTeX/markdown HTML (see lib/math/renderHtml).
  // Null = not yet backfilled → MathHtml falls back to live rendering.
  question_html          String?
  explanation_html       String?
  options_html           Json?
  question_html_hindi    String?
  explanation_html_hindi String?
  options_html_hindi     Json?
  render_version         Int              @default(0)
  // AI answer-review pass (admin/ai-review) — see PYQ for semantics.
  ai_reviewed_at         DateTime?
  ai_answer_mismatch     Boolean?
  ai_detected_answer     String?
  ai_review_model        String?
  attempts               Attempt[]
  bookmarks              Bookmark[]
  pattern                Pattern          @relation(fields: [pattern_id], references: [id])
  questionReports        QuestionReport[]

  @@index([pattern_id, created_at(sort: Desc)])
  @@index([pattern_id])
  @@index([ai_reviewed_at])
}

model Attempt {
  id               String             @id @default(uuid())
  user_id          String
  question_id      String?
  is_correct       Boolean
  created_at       DateTime           @default(now())
  pyq_id           String?
  user_answer      String?
  time_spent       Int?
  mock_question_id String?
  mock_test_id     String?
  MockTestTemplate MockTestTemplate?  @relation(fields: [mock_test_id], references: [id])
  pyq              PYQ?               @relation(fields: [pyq_id], references: [id])
  question         GeneratedQuestion? @relation(fields: [question_id], references: [id])
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_correct, created_at(sort: Desc)])
  @@index([question_id, user_id, is_correct])
  @@index([pyq_id, user_id, is_correct])
}

model TestSession {
  id              String            @id @default(uuid())
  user_id         String
  score           Float
  max_score       Float
  total_questions Int
  correct_count   Int
  wrong_count     Int
  skipped_count   Int
  time_taken_secs Int?
  answers         Json
  created_at      DateTime          @default(now())
  mock_test_id    String?
  branch          String?
  exam_type       String            @default("GATE")
  section_scores  Json?
  mock_test       MockTestTemplate? @relation(fields: [mock_test_id], references: [id])

  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id, exam_type, created_at(sort: Desc)])
}

model MockTestTemplate {
  id              String        @id @default(uuid())
  title           String
  subjects        String[]
  total_questions Int
  max_score       Int
  questions       Json
  created_at      DateTime      @default(now())
  branch          String?
  duration_secs   Int           @default(10800)
  exam_type       String        @default("GATE")
  mock_number     Int           @default(0)
  mode            String        @default("random")
  sections        Json?
  topics          String[]      @default([])
  content_hash    String?
  paper_year      Int?          @default(dbgenerated("(NULLIF(\"substring\"(title, '((19|20)\\d{2})'::text), ''::text))::integer"))
  Attempt         Attempt[]
  sessions        TestSession[]

  @@index([exam_type, branch, mock_number, mode])
  @@index([exam_type, branch, mode, paper_year], map: "mocktest_year_idx")
}

model UserNote {
  id         String   @id @default(uuid())
  user_id    String
  pattern_id String
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  pattern    Pattern  @relation(fields: [pattern_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, pattern_id])
}

/// Spaced Repetition System card state per user per question.
/// Uses a SuperMemo-2 inspired algorithm.
model Flashcard {
  id               String   @id @default(uuid())
  user_id          String
  question_id      String?
  pyq_id           String?
  interval         Int      @default(0)
  ease_factor      Float    @default(2.5)
  repetitions      Int      @default(0)
  next_review      DateTime @default(now())
  status           String   @default("new")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  last_grade       String?
  mock_question_id String?
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id])
  @@unique([user_id, pyq_id])
  @@unique([user_id, mock_question_id])
  @@index([user_id, next_review])
  @@index([user_id, status])
}

model Bookmark {
  id               String             @id @default(uuid())
  user_id          String
  question_id      String?
  pyq_id           String?
  created_at       DateTime           @default(now())
  mock_question_id String?
  pyq              PYQ?               @relation(fields: [pyq_id], references: [id], onDelete: Cascade)
  question         GeneratedQuestion? @relation(fields: [question_id], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id])
  @@unique([user_id, pyq_id])
  @@unique([user_id, mock_question_id])
  @@index([user_id])
}

model TestSessionDraft {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id      String
  mock_test_id String?
  exam_type    String
  branch       String?
  started_at   DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @db.Timestamptz(6)
  state        Json     @default("{}")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@index([user_id, mock_test_id])
  @@index([expires_at])
}

model QuestionReport {
  id               String             @id @default(uuid())
  user_id          String
  question_id      String?
  pyq_id           String?
  reason           String
  details          String?
  status           String             @default("pending")
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  mock_question_id String?
  pyq              PYQ?               @relation(fields: [pyq_id], references: [id], onDelete: Cascade)
  question         GeneratedQuestion? @relation(fields: [question_id], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@index([question_id])
  @@index([pyq_id])
}

// ─── B2B Coaching Layer ───────────────────────────────────────────────────────

model Coaching {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  city            String?
  exam_types      String[]           @default([])
  join_code       String             @unique
  owner_email     String? // set at creation; first Clerk login with this email claims the coaching
  // Application lifecycle. Super-admin-created coachings default to "approved";
  // public self-serve applications (/for-coachings) start "pending" and stay
  // inactive until a super admin approves (or rejects) them.
  status          String             @default("approved") // pending | approved | rejected
  applicant_name  String? // contact person from a public application
  applicant_phone String? // contact phone from a public application
  billing_mode    String             @default("per_test") // per_test | monthly
  price_per_test  Int                @default(15) // used when billing_mode = per_test
  monthly_fee     Int                @default(0) // flat ₹/month when billing_mode = monthly
  active          Boolean            @default(true)
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  admins          CoachingAdmin[]
  batches         Batch[]
  students        Student[]
  questions       CoachingQuestion[]
  tests           CoachingTest[]
  billing         BillingEvent[]
  billing_periods BillingPeriod[]

  @@index([slug])
  @@index([city])
  @@index([active])
}

model CoachingAdmin {
  id          String   @id @default(uuid())
  coaching_id String
  clerk_id    String   @unique
  role        String   @default("admin") // admin | owner
  created_at  DateTime @default(now())
  coaching    Coaching @relation(fields: [coaching_id], references: [id], onDelete: Cascade)

  @@index([coaching_id])
}

model Batch {
  id          String    @id @default(uuid())
  coaching_id String
  name        String
  created_at  DateTime  @default(now())
  coaching    Coaching  @relation(fields: [coaching_id], references: [id], onDelete: Cascade)
  students    Student[]

  @@unique([coaching_id, name])
  @@index([coaching_id])
}

model Student {
  id            String        @id @default(uuid())
  coaching_id   String
  batch_id      String?
  name          String
  phone         String
  active        Boolean       @default(true)
  // Enrollment approval (orthogonal to `active`, which is the session/soft-delete
  // gate). Code-joined students land "pending" until the owner approves; an
  // approved student can take tests. Owner-added students default "approved" — the
  // owner adding you IS the authorization. Default "approved" also keeps every
  // pre-existing row enrolled on migration.
  status        String        @default("approved") // pending | approved | rejected
  // Single active session enforcement ("newest login wins"): each login writes a
  // fresh token here and into the cookie; a session whose token != this is dead.
  session_token String?
  // Login secret: scrypt hash of the student's PIN (salt:hash). Set at join; phone
  // alone can't log in. Null = not set yet (must join with code to set one).
  pin_hash      String?
  joined_at     DateTime      @default(now())
  coaching      Coaching      @relation(fields: [coaching_id], references: [id], onDelete: Cascade)
  batch         Batch?        @relation(fields: [batch_id], references: [id])
  attempts      TestAttempt[]

  @@unique([coaching_id, phone])
  // Students list is WHERE coaching_id ORDER BY joined_at DESC (+ pagination);
  // the composite serves that ordered scan and coaching_id-only lookups (prefix).
  @@index([coaching_id, joined_at(sort: Desc)])
  @@index([batch_id])
  // Serves the owner's "pending approvals" list: WHERE coaching_id AND status.
  @@index([coaching_id, status])
}

model CoachingQuestion {
  id             String    @id @default(uuid())
  coaching_id    String?
  question_text  String
  question_html  String?
  options        Json
  correct_answer String
  solution       String?
  solution_html  String?
  question_type  String    @default("mcq") // mcq | nat | subjective
  max_marks      Int       @default(1)
  nat_tolerance  Float?
  // grade = exam/class ("SSC", "Class 8"); subject = section (from the ExamSection
  // catalog, e.g. "Quant"); set_name = the set/mock/chapter the question belongs to
  // ("Mock 5") — the grouping that keeps newly-added questions from getting lost;
  // topic = optional fine-grained concept tag (nullable).
  grade          String?
  subject        String?
  topic          String?
  set_name       String?
  difficulty     String?
  images         Json?
  // Bilingual: Hindi counterparts (null → fall back to the English column).
  question_text_hindi String?
  question_html_hindi String?
  options_hindi       Json?
  solution_hindi      String?
  solution_html_hindi String?
  created_at     DateTime  @default(now())
  coaching       Coaching? @relation(fields: [coaching_id], references: [id], onDelete: SetNull)

  // Bank list is WHERE coaching_id ORDER BY created_at DESC (+ pagination).
  @@index([coaching_id, created_at(sort: Desc)])
  @@index([coaching_id, subject])
  // Folder hierarchy browse/filter: group by grade → subject → set_name.
  @@index([coaching_id, grade, subject])
  @@index([coaching_id, grade, set_name])
}

// Light, one-level catalog of the sections each exam/class has (JEE = Physics/
// Chemistry/Math; SSC = Quant/Reasoning/English/GA; Class 8 = Science/Math/SST…).
// coaching_id = null → a global seeded default visible to everyone; coaching_id set
// → a coaching's own override/custom section. The question's `subject` is chosen
// from this list, so full tests + section analytics stay consistent.
model ExamSection {
  id            String   @id @default(uuid())
  coaching_id   String? // null = global seeded; set = coaching-owned
  exam          String // "SSC", "JEE", "Class 8"
  name          String // "Quant", "Physics", "Science"
  sort_order    Int      @default(0)
  default_marks Int?
  created_at    DateTime @default(now())

  @@unique([coaching_id, exam, name])
  @@index([coaching_id, exam])
  @@index([exam])
}

// One level below ExamSection: the fixed syllabus topics each (exam/class, section)
// has — Class 11 / Mathematics = Sets, Relations & Functions, … Integrals. School
// classes (CBSE 6-12) have a standardized syllabus, so topics are a constrained
// catalog here rather than free text; competitive exams with no rows fall back to
// the admin-typed topic list at import time. coaching_id = null → global seeded;
// set → a coaching's own topic. A question's `topic` is chosen from this list, so
// chapter-wise filtering + analytics stay consistent.
model SyllabusTopic {
  id          String   @id @default(uuid())
  coaching_id String? // null = global seeded; set = coaching-owned
  exam        String // "Class 11"  (matches CoachingQuestion.grade / ExamSection.exam)
  section     String // "Mathematics" (matches an ExamSection.name)
  name        String // "Integrals"
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())

  @@unique([coaching_id, exam, section, name])
  @@index([coaching_id, exam])
  @@index([exam, section])
}

model CoachingTest {
  id            String        @id @default(uuid())
  coaching_id   String
  title         String
  description   String?
  questions     Json // [{ id, source: "coaching"|"pyq"|"generated", marks, neg_marks, section? }]
  duration_secs Int           @default(3600)
  start_at      DateTime?
  end_at        DateTime?
  shuffle       Boolean       @default(true)
  pool_size     Int? // if set, each student gets pool_size random questions
  // Ordered section names this test renders/scoring by (null = single flat section).
  sections      Json?
  status        String        @default("draft") // draft | active | closed
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  coaching      Coaching      @relation(fields: [coaching_id], references: [id], onDelete: Cascade)
  attempts      TestAttempt[]

  // Tests list is WHERE coaching_id ORDER BY created_at DESC.
  @@index([coaching_id, created_at(sort: Desc)])
  @@index([coaching_id, status])
}

model TestAttempt {
  id              String        @id @default(uuid())
  coaching_id     String
  test_id         String
  student_id      String
  status          String        @default("in_progress") // in_progress | submitted
  answers         Json          @default("{}")
  score           Float?
  max_score       Float?
  time_taken_secs Int? // total time spent (analysis)
  question_times  Json? // { questionId: secondsSpent }
  tab_switches    Int           @default(0)
  manual_scores   Json? // { question_id: marks } for subjective questions
  // Per-section results: [{ name, score, maxScore, correct, wrong, skipped }] (null = unsectioned).
  section_scores  Json?
  graded_by       String? // coach admin id
  graded_at       DateTime?
  // Subjective AI-grading lifecycle: none (no subjective on paper) | pending
  // (submitted, awaiting Gemini) | review (AI pass done, ≥1 answer needs the
  // teacher: low confidence or grading failure) | done (every answer final).
  grading_status  String        @default("none")
  billed          Boolean       @default(false)
  started_at      DateTime      @default(now())
  submitted_at    DateTime?
  test            CoachingTest  @relation(fields: [test_id], references: [id])
  student         Student       @relation(fields: [student_id], references: [id])
  billing_event   BillingEvent?

  @@unique([test_id, student_id])
  // Dashboard "recent" + monthly aggregates are WHERE coaching_id ORDER BY
  // submitted_at DESC; the composite serves that and coaching_id-only (prefix).
  @@index([coaching_id, submitted_at(sort: Desc)])
  @@index([test_id])
  @@index([student_id])
  @@index([coaching_id, billed])
  // Admin results page: "which attempts of this test still need grading/review".
  @@index([test_id, grading_status])
}

// Per-month bill status a super admin toggles (due | paid). Amounts are derived
// from the coaching's billing_mode: submissions × price_per_test (per_test) or the
// flat monthly_fee (monthly). This row persists the status (and a snapshot of
// submissions/amount when it was marked). One row per (coaching, month).
model BillingPeriod {
  id          String    @id @default(uuid())
  coaching_id String
  period      DateTime // first day of the billed month (00:00 UTC)
  submissions Int       @default(0)
  amount      Int       @default(0)
  status      String    @default("due") // due | paid
  paid_at     DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  coaching    Coaching  @relation(fields: [coaching_id], references: [id], onDelete: Cascade)

  @@unique([coaching_id, period])
  @@index([coaching_id])
}

model BillingEvent {
  id          String      @id @default(uuid())
  coaching_id String
  attempt_id  String      @unique
  amount      Int
  status      String      @default("pending") // pending | paid
  created_at  DateTime    @default(now())
  coaching    Coaching    @relation(fields: [coaching_id], references: [id], onDelete: Cascade)
  attempt     TestAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@index([coaching_id])
  @@index([coaching_id, status])
}
